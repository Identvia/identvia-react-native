{
  "name": "@identvia/react-native",
  "version": "0.1.0",
  "description": "Sign in with Identvia for React Native and Expo: system browser (ASWebAuthenticationSession / Custom Tabs), PKCE S256, secure storage, refresh-token rotation, Expo config plugin.",
  "license": "MIT",
  "author": "Identvia <hello@identvia.com>",
  "homepage": "https://id.identvia.com/developers/docs/react-native",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/identvia/identvia-react-native.git"
  },
  "keywords": [
    "identvia",
    "react-native",
    "expo",
    "oidc",
    "pkce",
    "oauth2",
    "sso"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "plugin/build",
    "app.plugin.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p plugin/tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "expo-crypto": ">=13",
    "expo-secure-store": ">=13",
    "expo-web-browser": ">=13",
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-svg": ">=13"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/config-plugins": "^9.0.10",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "expo-crypto": "^58.0.7",
    "expo-secure-store": "^58.0.2",
    "expo-web-browser": "^58.0.6",
    "jose": "^5.9.6",
    "react": "^18.3.1",
    "react-native": "^0.76.9",
    "react-native-svg": "^15.16.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "react-native": "./src/core.ts",
      "default": "./dist/core.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  }
}
